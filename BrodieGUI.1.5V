--[[
    Protected by Aristoscated
]]--

local encodedData = ""

local success, decodedCode = pcall(function()
    return game:GetService("HttpService"):Base64Decode(encodedData)
end)

if success and decodedCode then
    local fn, err = loadstring(decodedCode)
    if fn then
        task.spawn(fn)
    else
        warn("BrodieGUI: Failed to compile script.")
    end
else
    warn("BrodieGUI: Failed to decode script.")
end
